# Fragment merged on top of arch/arm/configs/sunxi_defconfig.

# Display: A33 TCON -> MIPI-DSI -> JD9365DA-H3 panel, PWM backlight, Mali-400
CONFIG_DRM_SUN6I_DSI=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_DRM_PANEL_JADARD_JD9365DA_H3=y
CONFIG_DRM_LIMA=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# Touch: Silead GSL1680, firmware built in
CONFIG_TOUCHSCREEN_SILEAD=y
CONFIG_EXTRA_FIRMWARE="silead/gsl1680-k101-frame.fw"

# Wi-Fi: RTL8188FU on the internal USB host port (firmware comes with the rootfs)
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RTL8XXXU=m
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y

# OTG port as a USB gadget: CDC composite (ACM serial console + ECM network)
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_CDC_COMPOSITE=y
CONFIG_U_SERIAL_CONSOLE=y

# Accelerometer (MiraMEMS DA217-class on I2C1) is not needed on a fixed frame.

# Initramfs / rootfs basics
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MODULES=y

# Bring-up safety net: U-Boot starts the SoC watchdog before booting and the
# kernel does not feed it; only userspace does (busybox watchdog in the
# initramfs). A hang or panic resets the frame back to FEL (DRAM does not
# survive that reset, so capture the console live: tools/fel-boot-linux.sh).
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set

# systemd (Debian rootfs): cgroup v2 controllers, BPF device/firewall
# programs, autofs, ACL/xattr on tmpfs, IPC
CONFIG_MEMCG=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_FANOTIFY=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPV6=y
CONFIG_SECCOMP_FILTER=y

# Chromium's namespace sandbox
CONFIG_USER_NS=y
CONFIG_IPC_NS=y

# Compressed swap in RAM: Chromium on 1 GB
CONFIG_ZRAM=m
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# Tailscale: TUN device and the netfilter bits tailscaled programs
# (iptables-nft backend)
CONFIG_TUN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y

# iwd does WPA/802.1X crypto through the kernel's AF_ALG and keyctl APIs
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y

# zram compressors are separate backends since 6.12
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y

# iwd refuses to run without /dev/rfkill
CONFIG_RFKILL=y

# A33 temperature sensor (thermal zone + CPU throttling); on this SoC it is
# the GPADC driver, not sun8i_thermal
CONFIG_IIO=y
CONFIG_SUN4I_GPADC=y
