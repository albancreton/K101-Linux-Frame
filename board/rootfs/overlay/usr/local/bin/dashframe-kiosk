#!/bin/sh
# Runs inside cage: rotate the output to landscape, then the browser.
# The panel is 800x1280 portrait mounted on its side (see board/dts).
wlr-randr --output DSI-1 --transform 270 || true
. /etc/dashframe.conf

case "${BROWSER:-wpe}" in
chromium)
	# Fallback. The Mali-400 only does GLES 2 and Chromium needs GLES 3, so
	# Chromium renders on the CPU (ANGLE + SwiftShader): ~2 fps when scrolling.
	exec chromium \
		--kiosk --noerrdialogs --disable-infobars --no-first-run \
		--disable-session-crashed-bubble --disable-features=Translate \
		--overscroll-history-navigation=0 --password-store=basic \
		--check-for-update-interval=31536000 \
		--ozone-platform=wayland \
		--use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader \
		--disable-gpu-process-crash-limit --hide-scrollbars \
		"$DASHBOARD_URL"
	;;
*)
	# WPE WebKit composites with GLES 2 on the GPU: ~20 fps when scrolling.
	exec cog --platform=wl --webprocess-failure=restart "$DASHBOARD_URL"
	;;
esac
